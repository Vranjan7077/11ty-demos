{
    "name": "11ty-demos",
    "version": "1.0.0",
    "private": true,
    "description": "A single Eleventy site that showcases many independent 11ty implementation patterns as standalone demo pages.",
    "type": "module",
    "author": {
        "name": "Vinay Ranjan",
        "url": "https://vranjan.dev/"
    },
    "homepage": "https://github.com/Vranjan7077/11ty-demos#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vranjan7077/11ty-demos.git"
    },
    "bugs": {
        "url": "https://github.com/Vranjan7077/11ty-demos/issues"
    },
    "engines": {
        "node": ">=24"
    },
    "keywords": [
        "eleventy",
        "11ty",
        "static-site-generator",
        "nunjucks",
        "netlify",
        "demo"
    ],
    "scripts": {
        "clean": "rimraf public",
        "build": "npm run clean && eleventy && npm run build:pagefind",
        "build:eleventy": "eleventy",
        "build:pagefind": "pagefind --site public",
        "start": "eleventy --serve",
        "debug": "cross-env DEBUG=Eleventy* eleventy",
        "test": "node --test \"test/*.test.js\"",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{js,scss,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,scss,json,md}\"",
        "test:smoke": "node --test \"test/smoke/*.test.js\"",
        "check": "npm run lint && npm run format:check && npm test && npm run build && npm run test:smoke"
    },
    "dependencies": {
        "@11ty/eleventy": "^3.1.2",
        "@11ty/eleventy-fetch": "^6.0.1",
        "@11ty/eleventy-img": "^7.1.1",
        "@11ty/eleventy-navigation": "^1.0.4",
        "@11ty/eleventy-plugin-rss": "^3.1.0",
        "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.1",
        "@netlify/blobs": "^11.1.6",
        "@resvg/resvg-js": "^2.6.2",
        "dotenv": "^18.0.9",
        "eleventy-plugin-reading-time": "^0.0.1",
        "fast-glob": "^3.3.3",
        "html-minifier-terser": "^7.2.0",
        "markdown-it-anchor": "^10.0.0",
        "sass": "^1.83.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "cross-env": "^7.0.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.7.0",
        "globals": "^17.7.0",
        "pagefind": "^1.5.2",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3"
    }
}
