---
title: "Demos"
description: "Every Eleventy implementation pattern on this site, in one place — real, working, and self-contained."
eleventyNavigation:
  key: Demos
  order: 2
---
{% extends "layouts/base.njk" %}
{% import "components/demo-card.njk" as demoCardC %}

{% set schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": site.url + page.url,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": collections.demos | demosToItemList(site.url)
  }
} %}

{% block content %}
<script type="application/ld+json">{{ schema | jsonLd | safe }}</script>
<div class="wrapper">
  <header class="page__header">
    <h1 class="page__title">{{ title }}</h1>
    <p class="page__lede">{{ description }}</p>
  </header>

  <form class="demo-filter" data-demo-filter>
    <div class="form-field">
      <label for="demo-filter-tag">Tag</label>
      <select id="demo-filter-tag" name="tag">
        <option value="">All tags</option>
        {% for tag in collections.demoTags %}
        <option value="{{ tag | slugify }}">{{ tag }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="form-field">
      <label for="demo-filter-difficulty">Difficulty</label>
      <select id="demo-filter-difficulty" name="difficulty">
        <option value="">Any difficulty</option>
        <option value="beginner">Beginner</option>
        <option value="intermediate">Intermediate</option>
        <option value="advanced">Advanced</option>
      </select>
    </div>
    <p class="demo-filter__status" role="status" data-demo-filter-status>Showing {{ collections.demos.length }} of {{ collections.demos.length }} demos</p>
  </form>

  <div class="demo-grid">
    {% for demo in collections.demos %}
      {{ demoCardC.demoCard(demo, loop.index0 < 3) }}
    {% endfor %}
  </div>
</div>
{% endblock %}
