<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{% if title %}{{ title }} · {{ site.shortTitle }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if draft %}<meta name="robots" content="noindex">{% endif %}

  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#ffffff" data-light="#ffffff" data-dark="#0a0a0a">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  {% include "components/preferences-init.njk" %}
  <link rel="stylesheet" href="{{ '/assets/scss/main.css' | assetUrl }}">
  {% include "components/css-preference-init.njk" %}
  {% include "components/speculation-rules.njk" %}

  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  {% if ogType == "article" %}
  <meta property="article:published_time" content="{{ date | htmlDateString }}">
  {% if lastUpdated %}<meta property="article:modified_time" content="{{ lastUpdated }}">{% endif %}
  {% endif %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.shortTitle }}">
  {%- if difficulty %}{% set ogEyebrow = difficulty + " demo" %}{% elif tags and "post" in tags %}{% set ogEyebrow = "Blog post" %}{% else %}{% set ogEyebrow = ogEyebrow or "Eleventy demos" %}{% endif %}
  <meta property="og:image" content="{{ site.url }}{% ogImage ogTitle or title or site.title, description or site.description, ogEyebrow, thumbnail %}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ogTitle or title or site.title }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}{% ogImage ogTitle or title or site.title, description or site.description, ogEyebrow, thumbnail %}">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  {% include "components/header.njk" %}

  <main id="main" tabindex="-1">
    {% block content %}{% endblock %}
  </main>

  <a class="back-to-top" href="#main" data-back-to-top hidden><span aria-hidden="true">↑</span> Back to top</a>

  {% include "components/footer.njk" %}

  <script type="module" src="{{ '/assets/js/main.js' | assetUrl }}"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
