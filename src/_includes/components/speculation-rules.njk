<script type="speculationrules">
  {
    "prerender": [
      {
        "source": "document",
        "where": {
          "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": ["/.netlify/*", "/assets/*", "/pagefind/*", "/*.xml", "/*.json"] } },
            { "not": { "selector_matches": "[data-no-prerender]" } }
          ]
        },
        "eagerness": "moderate"
      }
    ]
  }
</script>
