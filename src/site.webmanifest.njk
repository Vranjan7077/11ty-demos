---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": {{ site.title | dump | safe }},
  "short_name": {{ site.shortTitle | dump | safe }},
  "description": {{ site.description | dump | safe }},
  "start_url": "/",
  "display": "browser",
  "background_color": "#ffffff",
  "theme_color": "#5b6bff",
  "icons": [
    { "src": "/assets/images/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/images/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/images/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
